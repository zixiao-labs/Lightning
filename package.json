{
  "name": "@lightning-js/lightning",
  "version": "3.0.0",
  "description": "Lightning A Next Generation Testing Framework - 比神霄派雷法还快的测试框架，让测试更简单！",
  "keywords": [
    "test",
    "jest-alternative"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/zixiao-labs/Lightning#readme",
  "bugs": {
    "url": "https://github.com/zixiao-labs/Lightning/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixiao-labs/Lightning.git"
  },
  "license": "MIT",
  "author": "Zixiao Laboratories",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "lightning": "bin/lightning.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./globals": {
      "types": "./dist/globals.d.mts",
      "import": "./dist/globals.mjs",
      "default": "./dist/globals.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node bin/lightning.mjs run --root .",
    "test:runtime": "node --experimental-transform-types --test src/runtime/runtime.spec.ts",
    "test:integration": "pnpm build && node --test test/cli.integration.mjs test/docs.integration.mjs",
    "test:browser:integration": "pnpm build && node --test test/browser-workflows.integration.mjs",
    "test:frameworks": "pnpm build && node bin/lightning.mjs run --root playground/frameworks",
    "test:types": "pnpm build && node bin/lightning.mjs run --root playground/types --typecheck",
    "test:bench": "pnpm build && node bin/lightning.mjs bench --root playground/bench",
    "docs": "node website/serve.mjs",
    "test:browser": "pnpm build && node bin/lightning.mjs run --root playground/browser",
    "test:playground": "pnpm build && node bin/lightning.mjs run --root playground/basic math.test strings.test",
    "test:demo:fail": "pnpm build && node bin/lightning.mjs run --root playground/basic"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "playwright-core": "1.60.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.21.10",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@nasti-toolchain/nasti": "2.5.2",
    "cac": "^7.0.0",
    "expect-type": "^1.4.0",
    "import-meta-resolve": "^4.2.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "magic-string": "^0.30.21",
    "oxc-transform": "^0.147.0",
    "rolldown": "1.2.6",
    "tinybench": "^6.2.0",
    "tinyglobby": "^0.2.17",
    "tinyrainbow": "^3.1.1",
    "typescript": "^6.0.3",
    "v8-to-istanbul": "^9.3.0"
  }
}
